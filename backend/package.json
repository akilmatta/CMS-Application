{
  "name": "cms-backend",
  "version": "1.0.0",
  "description": "CMS Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "setup:validity": "ts-node scripts/setup-certification-validity.ts",
    "update:certifications": "ts-node scripts/update-certification-examples.ts",
    "update:validity": "ts-node src/utils/updateCertificationValidity.ts",
    "update:employees": "ts-node scripts/update-existing-employees.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^4.18.2",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.4.0",
    "form-data": "^4.0.4",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
